# Copy to .env and fill in. Never commit .env.

# DB — sqlite for local dev, Postgres for real deployments
DATABASE_URL=sqlite+aiosqlite:///./testpilot.db
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/testpilot

# Optional integrations — both OFF by default; a plain install needs neither.
# Flip to true to show their settings UI and enable their workers/endpoints.
ENABLE_GITLAB=false
ENABLE_FEISHU=false

# LLM gateway (OpenAI-compatible) — used by both the browser agent and the judge.
# These are the DEFAULTS; admins can override base URL / key / models at runtime
# in the UI (System settings → LLM model) without a redeploy.
GATEWAY_BASE_URL=https://api.openai.com/v1
GATEWAY_API_KEY=
GATEWAY_MODEL=gpt-4o
# browser-use agent model; leave empty to reuse GATEWAY_MODEL. The judge always
# uses GATEWAY_MODEL. e.g. AGENT_MODEL=Qwen3-VL to run the agent on a local VLM.
AGENT_MODEL=
# language for the agent's reasoning + judge reason (e.g. English, Chinese (简体中文))
REPORT_LANGUAGE=Chinese (简体中文)
GATEWAY_VERIFY_SSL=true

# Artifact storage (RustFS, S3-compatible). Leave S3_ENDPOINT empty to store locally under ./artifacts
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=testpilot
S3_REGION=us-east-1

# Encryption key for stored test credentials (Fernet). Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TESTPILOT_SECRET_KEY=

# Execution limits (a stuck case fails at CASE_TIMEOUT_S; no auto-retry by default)
DEFAULT_CONCURRENCY=2          # per-run workers (in-process fallback only)
CASE_MAX_STEPS=30
CASE_TIMEOUT_S=60
# Session lifetime of the app under test; a captured login is re-used until this runs
# out, then re-captured once for the whole run. Keep it just under the real one.
SESSION_TTL_MIN=25
CASE_RETRIES=0
# Global browser budget across ALL runs/users (~0.5 GB RAM each). With Redis/Celery this
# MUST match the worker's --concurrency (compose reads it from here); the in-process
# fallback uses it as a shared semaphore.
MAX_GLOBAL_CONCURRENCY=16

# GitLab two-way issue sync (Celery worker + beat). Empty REDIS_URL => sync disabled.
# docker-compose overrides REDIS_URL/DATABASE_URL to the bundled redis/postgres.
REDIS_URL=
GITLAB_BASE_URL=https://gitlab.com/api/v4
GITLAB_VERIFY_SSL=true
GITLAB_POLL_INTERVAL_S=60
# Server-wide GitLab token (api scope). Set this and projects need only pick a
# GitLab project in the UI — no per-project token. Keep it out of git.
GITLAB_TOKEN=

# --- accounts / auth ---
# AUTH_ENABLED requires login on every endpoint; flip to true for multi-user.
AUTH_ENABLED=false
# SHARED_WORKSPACE: any logged-in user has full access to every project (login gate only,
# no per-project RBAC). Set false to enforce ProjectMember owner/editor/viewer.
SHARED_WORKSPACE=true
JWT_SECRET=                    # HS256 signing key (openssl rand -hex 32); required once AUTH_ENABLED
JWT_TTL_HOURS=168
# First admin, seeded on first startup when no users exist:
ADMIN_EMAIL=
ADMIN_PASSWORD=
PUBLIC_BASE_URL=              # base for invite links, e.g. https://testpilot.example.com

# System SMTP for invite emails
EMAIL_FROM=noreply@example.com
EMAIL_HOST=smtp.example.com
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_SSL=false
EMAIL_USE_TLS=false

# Postgres password for the docker-compose `db` service (compose builds
# DATABASE_URL from it). Ignored when DATABASE_URL is set directly.
POSTGRES_PASSWORD=testpilot

# Built frontend served by the API. The Docker image sets this to /app/web_dist;
# leave empty for local dev (Vite serves the SPA).
WEB_DIST=
