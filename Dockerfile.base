# ============================================
# TestPilot base image — Python 3.11 + all deps + Playwright/Chromium + OS libs
# ============================================
# Built separately; the main Dockerfile uses it as BASE_IMAGE and only layers
# app code + built frontend on top, so it installs NOTHING — app builds are
# "pull base + COPY" (fast).
#
# Every Python dependency (from pyproject.toml) AND the Playwright Chromium
# browser + its runtime OS libs live here. A NEW Python dependency (edit
# pyproject.toml) means rebuilding this base; do NOT add a `pip install`
# to the main Dockerfile.
#
# Build:  docker build -f Dockerfile.base -t testpilot-base:latest .
# ============================================

# Mirror knobs for networks where the public defaults are slow or unreachable
# (corporate registries, CN mirrors, air-gapped CI). All optional:
#   --build-arg PYTHON_IMAGE=<registry>/python:3.11-slim
#   --build-arg DEBIAN_MIRROR=mirrors.example.com          (replaces deb.debian.org)
#   --build-arg PIP_INDEX_URL=https://pypi.example.com/simple
#   --build-arg PIP_EXTRA_INDEX_URL=...
#   --build-arg PLAYWRIGHT_DOWNLOAD_HOST=https://cdn.example.com/binaries/playwright
ARG PYTHON_IMAGE=python:3.11-slim
FROM ${PYTHON_IMAGE}

ARG DEBIAN_MIRROR=""
ARG PIP_INDEX_URL=""
ARG PIP_EXTRA_INDEX_URL=""
ARG PLAYWRIGHT_DOWNLOAD_HOST=""

# uv + curl (curl is used by the compose healthcheck).
RUN if [ -n "$DEBIAN_MIRROR" ]; then \
        sed -i "s/deb.debian.org/${DEBIAN_MIRROR}/g" /etc/apt/sources.list.d/debian.sources; \
    fi \
    && apt-get update \
    && apt-get install -y --no-install-recommends curl ca-certificates \
    && curl -LsSf https://astral.sh/uv/install.sh | sh \
    && rm -rf /var/lib/apt/lists/*

# Empty PLAYWRIGHT_DOWNLOAD_HOST is falsy to playwright's installer => default CDN.
ENV PATH="/root/.local/bin:$PATH" \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
    PLAYWRIGHT_DOWNLOAD_HOST=${PLAYWRIGHT_DOWNLOAD_HOST}

WORKDIR /app

# Python deps straight from pyproject.toml (installs [project.dependencies],
# including browser-use[video] + playwright + celery/redis). Only pyproject is
# copied, so app-code changes never invalidate this layer.
COPY pyproject.toml ./
RUN uv pip install --system --no-cache -r pyproject.toml \
        ${PIP_INDEX_URL:+--index-url ${PIP_INDEX_URL}} \
        ${PIP_EXTRA_INDEX_URL:+--extra-index-url ${PIP_EXTRA_INDEX_URL}}

# Chromium + its OS dependencies, into a world-readable path so the non-root
# runtime user can launch it. --with-deps installs the apt libs Chromium needs.
RUN playwright install --with-deps chromium \
    && chmod -R a+rX /ms-playwright

CMD ["python3"]
